PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sira_academy
# PGSSL=true   # set for managed Postgres that requires TLS (Supabase, Neon, RDS...)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
VIDEO_TOKEN_SECRET=change-me-video
VIDEO_TOKEN_EXPIRES=5m

# Google Drive — one OAuth app; individual storage_accounts rows hold per-account refresh tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/admin/drive/oauth/callback
DRIVE_TOKEN_ENCRYPTION_KEY=change-me-32-bytes-min

# Paymob (Egypt)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
